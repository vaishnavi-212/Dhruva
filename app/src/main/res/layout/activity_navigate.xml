<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header bar: logo + map style toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/dhruva_surface"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_logo_frame"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dhruva_logo"
                    android:contentDescription="@string/app_name" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DHRUVA · NAVIGATE"
                android:textColor="@color/dhruva_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMapStandard"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Standard"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="@color/dhruva_teal"
                android:background="@drawable/bg_button_outline" />

            <Button
                android:id="@+id/btnMapTerrain"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Terrain"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="@color/dhruva_teal"
                android:background="@drawable/bg_button_outline" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnWhereTo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:text="Loading map…"
        android:enabled="false"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dhruva_bg"
        android:background="@drawable/bg_button_primary" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvErrorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 m apart"
        android:textColor="@color/dhruva_amber"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@color/dhruva_pill_bg"
        android:padding="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dhruva_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Navigation / sensor card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glow"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="@color/dhruva_cyan"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAVIGATION"
                        android:textColor="@color/dhruva_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mode: GNSS"
                        android:textColor="@color/dhruva_text"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/switchBlackout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulate GPS loss"
                        android:textColor="@color/dhruva_text_dim"
                        android:textSize="12sp"
                        android:thumbTint="@color/dhruva_teal"
                        android:trackTint="@color/dhruva_border" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Road binding"
                        android:textColor="@color/dhruva_text"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnRoute"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:text="Route: auto"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/dhruva_teal"
                        android:background="@drawable/bg_button_outline"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <Switch
                        android:id="@+id/switchRoadBinding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dhruva_text_dim"
                        android:textSize="12sp"
                        android:thumbTint="@color/dhruva_teal"
                        android:trackTint="@color/dhruva_border" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSensorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gyro bias: measuring…"
                    android:textColor="@color/dhruva_text_dim"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Save actions card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_glow"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnSaveRoute"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save track as route"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/dhruva_teal"
                    android:background="@drawable/bg_button_outline" />

                <Button
                    android:id="@+id/btnSaveMap"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Save map offline"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/dhruva_teal"
                    android:background="@drawable/bg_button_outline" />

            </LinearLayout>

            <Button
                android:id="@+id/btnFinishRun"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Finish Run"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/dhruva_bg_deep"
                android:background="@drawable/bg_button_primary" />

            <!-- Run summary card -->
            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glow"
                android:padding="18dp"
                android:visibility="gone">

                <View
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_badge_verdict"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERDICT"
                    android:textColor="@color/dhruva_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/summaryVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/dhruva_teal"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/summaryDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance: —"
                    android:textColor="@color/dhruva_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/summaryError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Final error: —"
                    android:textColor="@color/dhruva_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/summaryDrift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drift: —"
                    android:textColor="@color/dhruva_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/summarySpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mean speed: —"
                    android:textColor="@color/dhruva_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/summaryConf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confidence: —"
                    android:textColor="@color/dhruva_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/summaryHz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMU rate: —"
                    android:textColor="@color/dhruva_text_dim"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnCloseSummary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Close"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/dhruva_bg_deep"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
