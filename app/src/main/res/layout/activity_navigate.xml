<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dhruva_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/dhruva_surface">

        <Button
            android:id="@+id/btnMapStandard"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Standard"
            android:textSize="13sp"
            android:textColor="@color/dhruva_teal"
            android:background="@drawable/bg_button_outline" />

        <Button
            android:id="@+id/btnMapTerrain"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Terrain"
            android:textSize="13sp"
            android:textColor="@color/dhruva_teal"
            android:background="@drawable/bg_button_outline" />

    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/dhruva_surface"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mode: GNSS"
            android:textColor="@color/dhruva_text"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchBlackout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulate GPS loss"
            android:textColor="@color/dhruva_text_dim"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>