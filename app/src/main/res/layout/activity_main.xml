<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dhruva_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dhruva"
        android:textColor="@color/dhruva_teal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ride Recorder"
        android:textColor="@color/dhruva_text_dim"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: waiting for fix..."
            android:textColor="@color/dhruva_text"
            android:textSize="15sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvHz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accel: -- Hz"
            android:textColor="@color/dhruva_text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvElapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elapsed: 00:00"
            android:textColor="@color/dhruva_text"
            android:textSize="15sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance: 0.0 m"
            android:textColor="@color/dhruva_text"
            android:textSize="15sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Recording"
        android:textSize="16sp"
        android:textColor="@color/dhruva_bg"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Share Last Run"
        android:textSize="15sp"
        android:textColor="@color/dhruva_teal"
        android:background="@drawable/bg_button_outline"
        android:enabled="false"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnNavigate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Open Navigate Screen"
        android:textSize="15sp"
        android:textColor="@color/dhruva_teal"
        android:background="@drawable/bg_button_outline" />

</LinearLayout>