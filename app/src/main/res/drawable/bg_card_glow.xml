<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer glow -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dhruva_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/dhruva_border_glow" />
        </shape>
    </item>
    <!-- crisp inner border -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/dhruva_border" />
        </shape>
    </item>
</layer-list>
